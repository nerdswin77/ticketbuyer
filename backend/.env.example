# Copy to .env and adjust.

# SQLite by default; any SQLAlchemy URL works.
DATABASE_URL=sqlite:///./kickoff.db

# Leave Stripe keys empty to use the built-in mock payment gateway.
# Use TEST keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From `stripe listen --forward-to localhost:8000/api/payments/webhook`
STRIPE_WEBHOOK_SECRET=

CURRENCY=eur
# Seconds a seat hold survives while waiting for 3-D Secure authentication
HOLD_SECONDS=120
# Simulated rival buyers drain inventory after a sale opens
SIMULATE_RIVALS=true
# Re-generate sale opening times (seconds/minutes from now) on every start
DEMO_RESET_ON_START=true
